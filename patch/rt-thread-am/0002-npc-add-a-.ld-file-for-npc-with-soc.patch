From 32e2840830adbba05be29bc9af622ae95cc8b6c4 Mon Sep 17 00:00:00 2001
From: 2023k8009929022-LiuYaoqing <liuyaoqing23@mails.ucas.ac.cn>
Date: Fri, 5 Jun 2026 16:13:28 +0800
Subject: [PATCH 2/4] npc: add a .ld file for npc with soc

---
 bsp/abstract-machine/extra-nosoc.ld | 45 +++++++++++++++++++++++++++++
 bsp/abstract-machine/extra.ld       | 22 +++++++++++---
 2 files changed, 63 insertions(+), 4 deletions(-)
 create mode 100644 bsp/abstract-machine/extra-nosoc.ld

diff --git a/bsp/abstract-machine/extra-nosoc.ld b/bsp/abstract-machine/extra-nosoc.ld
new file mode 100644
index 000000000..9046ffa85
--- /dev/null
+++ b/bsp/abstract-machine/extra-nosoc.ld
@@ -0,0 +1,45 @@
+SECTIONS {
+  .data.extra : {
+    /* section information for finsh shell */
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    /* section information for initial. */
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+  }
+}
+INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+  }
+} 
+INSERT BEFORE .bss;
diff --git a/bsp/abstract-machine/extra.ld b/bsp/abstract-machine/extra.ld
index 5cdc65670..8ad129b73 100644
--- a/bsp/abstract-machine/extra.ld
+++ b/bsp/abstract-machine/extra.ld
@@ -1,5 +1,14 @@
+MEMORY {
+  sram : ORIGIN = 0x0f000000, LENGTH = 8K
+  mrom : ORIGIN = 0x20000000, LENGTH = 4K
+  flash : ORIGIN = 0x30000000, LENGTH = 0x10000000
+  psram : ORIGIN = 0x80000000, LENGTH = 0x400000
+}
+/* this is for npc with soc */
+
 SECTIONS {
   .data.extra : {
+    _edata_sa_start = .;
     /* section information for finsh shell */
     __fsymtab_start = .;
     KEEP(*(FSymTab))
@@ -27,12 +36,16 @@ SECTIONS {
     *(__am_apps.sdata*)
     __am_apps_data_end = .;
     . = ALIGN(8);
-  }
+    _edata_sa_end = .;
+  } > psram AT> flash : data
+  _edata_ma_start = LOADADDR(.data.extra);
+  _edata_ma_end = _edata_ma_start + SIZEOF(.data.extra);
 }
 INSERT BEFORE .data;
 
 SECTIONS {
-  .bss.extra : {
+  .bss.extra (NOLOAD) : {
+    _ebss_sa_start = .;
     . = ALIGN(8);
     __am_apps_bss_start = .;
     *(__am_apps.bss*)
@@ -40,6 +53,7 @@ SECTIONS {
     *(__am_apps.scommon*)
     __am_apps_bss_end = .;
     . = ALIGN(8);
-  }
-}
+    _ebss_sa_end = .;
+  } > psram AT> flash : bss
+} 
 INSERT BEFORE .bss;
-- 
2.34.1

