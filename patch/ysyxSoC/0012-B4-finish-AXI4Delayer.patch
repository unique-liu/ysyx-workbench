 }
 
 class APBDelayerChisel extends Module {
-  var r = 5 //delay times  npc is 500MHz soc is 100MHz
-  var s = 8 //delay multipler & divider
+  val r = 5 //delay times  npc is 500MHz soc is 100MHz
+  val s = 8 //delay multipler & divider
